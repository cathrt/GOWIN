# ==========================================
# 1. Gowin EDA 综合与实现输出 (体积大、纯自动生成)
# ==========================================
impl/
sim/
reports/
output/
temp/
device_temp/

# ==========================================
# 2. 高云临时工程与环境文件
# ==========================================
*.gws
*.gprj.user
project_crc.txt
*.bak
*.log
*.rpt
*.vst
*.db

# ==========================================
# 3. 高云在线逻辑分析仪 (GAO) 缓存
# ==========================================
*.gbt
*.gmd
gao_temp/

# ==========================================
# 4. 编辑器与操作系统垃圾
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.DS_Store
Thumbs.db

# ==========================================
# 5. 白名单：必须保留的核心设计源文件
# ==========================================
!*.gprj
!src/**
!tb/**
!constraint/**

# IP 目录：保留 IP 配置文件 (*.ipc) 与 HDL 封装，忽略生成过程产生的临时垃圾
!ip/**
ip/**/*.log
ip/**/temp/