
#         FPGA 项目通用 SDC 时序约束模板

# ==============================================================================
# 1. 主输入物理时钟约束 (Primary Clock)
# 作用: 告知综合与布线器板载晶振基准频率与周期，作为静态时序分析的核心标尺。
# 语法: create_clock -name <时钟别名> -period <周期ns> -waveform {上升沿时间 下降沿时间} [get_ports {顶层端口名}]
# ==============================================================================

# 50MHz 板载主时钟 (周期 20ns, 占空比 50%)
create_clock -name clk -period 20.000 -waveform {0.000 10.000} [get_ports {clk}]


# ==============================================================================
# 2. 片上衍生与分频时钟约束 (Generated Clocks)
# 作用: 对片上 PLL、逻辑分频器产生的时钟声明频率与源时钟派生关系。
# 注意: Gowin 在例化片上 PLL IP 核后通常会自动推导衍生时钟；
#      若使用了纯逻辑触发器分频（如 clk_div2/clk_1k），且该信号驱动了其他逻辑的时钟端，可手动声明。
# ==============================================================================
# 示例：通过二分频逻辑输出的时钟引脚 (周期为源时钟 2 倍 = 40ns)
# create_generated_clock -name clk_div2 \
#     -source [get_ports {clk}] \               // 来源
#     -divide_by 2 \                            // 分频
#     [get_pins {u_divider/clk_div2_reg/Q}]     // 引脚


# ==============================================================================
# 3. 异步时钟域隔离 (Asynchronous Clock Groups)
# 作用: 告诉 STA 分析器不同时钟源之间不存在纳秒级相位相关性，忽略它们之间的跨时钟域建立/保持时间检查。
# ==============================================================================
# 示例：主时钟域与外部调试时钟/慢速时钟完全异步
# set_clock_groups -asynchronous \
#     -group [get_clocks {sys_clk}] \
#     -group [get_clocks {ext_clk}]


# ==============================================================================
# 4. 异步信号伪路径约束 (False Path - Inputs)
# 作用: 人手按键、机械开关、外部拨码、异步复位等均为慢速物理事件，
#      禁止编译器浪费宝贵的高速布线资源去收敛这些信号。
# ==============================================================================

# 异步低有效复位
set_false_path -from [get_ports {rstn}]

# 多位按键输入 (支持通配符匹配所有按键引脚)
set_false_path -from [get_ports {key_in[*]}]

# 编码器机械输入
set_false_path -from [get_ports {encode_a}]
set_false_path -from [get_ports {encode_b}]

# 20kHz 电机 PWM 输出
set_false_path -to [get_ports {pwm_out}]


# ==============================================================================
# 5. 慢速输出与执行机构伪路径约束 (False Path - Outputs)
# 作用: LED 指示灯、数码管段选/位选、继电器、慢速使能引脚对纳秒级建立时间完全不敏感。
# ==============================================================================

# 状态指示 LED
set_false_path -to [get_ports {led[*]}]

# 电机正反转方向线
set_false_path -to [get_ports {ain1}]
set_false_path -to [get_ports {ain2}]

# ADC 常开使能控制引脚 (常低)
set_false_path -to [get_ports {ad_oe}]


# ==============================================================================
# 6. 片上在线调试与 JTAG 伪路径 (Debugger / GAO / ILA)
# 作用: 消除由于在线逻辑分析仪引入的内部调试时钟警告 (如 TA1132)。
# ==============================================================================

# 高云 GAO JTAG 硬件时钟引脚解约束
set_false_path -from [get_ports {tck_pad_i}]

# ==============================================================================
# 7. 高速外设同步接口时序 (可选进阶 - IO Delay)
# 作用: 用于高速 ADC (如 3PA1030)、SRAM、SDRAM 等对引脚时钟对齐有严格纳秒级要求的总线。
# ==============================================================================
# 示例：ADC 数据有效输入延迟 (假设外置 ADC 在时钟有效沿后有 2ns~5ns 的延迟)
# set_input_delay -clock [get_clocks {clk_adc}] -max 5.0 [get_ports {ad_data[*]}]
# set_input_delay -clock [get_clocks {clk_adc}] -min 2.0 [get_ports {ad_data[*]}]
