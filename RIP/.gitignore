# ==========================================
# 1. 高云 Gowin EDA 综合与实现输出 (体积大、纯自动生成)
# ==========================================
impl/
reports/
output/
temp/
device_temp/

# ==========================================
# 2. 高云本地工程与用户环境配置
# ==========================================
*.gprj.user
*.gws
project_crc.txt
*.bak
*.log
*.rpt
*.vst
*.db

# ==========================================
# 3. ModelSim / 仿真临时文件与数据库
# ==========================================
work/
vsim.wlf
*.wlf
*.mpf
*.cr.mti
transcript

# ==========================================
# 4. 高云在线逻辑分析仪 (GAO) 运行时临时缓存
# ==========================================
*.gbt
*.gmd
gao_temp/

# ==========================================
# 5. 编辑器与操作系统临时文件
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.DS_Store
Thumbs.db

# ==========================================
# 6. 保留规则 (确保关键工程与源码不被误杀)
# ==========================================
!*.gprj
!src/**
!tb/**

# IP 目录：保留 IP 配置文件 (*.ipc) 与 HDL 封装代码，忽略生成日志与临时文件
!ip/**
ip/**/*.log
ip/**/temp/