module motor (
  clk_d,
  n13_6,
  motor_stop,
  duty_signed_2,
  duty_signed_8,
  duty_signed_12,
  pwm_out_d,
  ain1_d,
  ain2_d
)
;
input clk_d;
input n13_6;
input motor_stop;
input duty_signed_2;
input duty_signed_8;
input duty_signed_12;
output pwm_out_d;
output ain1_d;
output ain2_d;
wire motor_dir_Z;
wire [8:2] duty_unsigned_Z;
wire VCC;
wire GND;
  motor_control motor_control_inst (
    .clk_d(clk_d),
    .n13_6(n13_6),
    .motor_stop(motor_stop),
    .duty_signed_2(duty_signed_2),
    .duty_signed_8(duty_signed_8),
    .duty_signed_12(duty_signed_12),
    .motor_dir_Z(motor_dir_Z),
    .duty_unsigned_Z_2(duty_unsigned_Z[2]),
    .duty_unsigned_Z_3(duty_unsigned_Z[3]),
    .duty_unsigned_Z_8(duty_unsigned_Z[8])
);
  pwm pwm_inst (
    .clk_d(clk_d),
    .n13_6(n13_6),
    .motor_dir_Z(motor_dir_Z),
    .motor_stop(motor_stop),
    .duty_unsigned_Z_2(duty_unsigned_Z[2]),
    .duty_unsigned_Z_3(duty_unsigned_Z[3]),
    .duty_unsigned_Z_8(duty_unsigned_Z[8]),
    .pwm_out_d(pwm_out_d),
    .ain1_d(ain1_d),
    .ain2_d(ain2_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* motor */
module motor_top (
  clk,
  rst_n,
  key_in,
  ain1,
  ain2,
  pwm_out
)
;
input clk;
input rst_n;
input [3:0] key_in;
output ain1;
output ain2;
output pwm_out;
wire clk_d;
wire rst_n_d;
wire n28_15;
wire duty_signed_2_15;
wire n92_9;
wire n14_10;
wire motor_stop;
wire n13_6;
wire pwm_out_d;
wire ain1_d;
wire ain2_d;
wire [2:0] key_in_d;
wire [12:2] duty_signed;
wire [0:0] key_pulse_Z;
wire [1:1] key_pulse_Z_2;
wire [2:2] key_pulse_Z_3;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF key_in_0_ibuf (
    .O(key_in_d[0]),
    .I(key_in[0]) 
);
  IBUF key_in_1_ibuf (
    .O(key_in_d[1]),
    .I(key_in[1]) 
);
  IBUF key_in_2_ibuf (
    .O(key_in_d[2]),
    .I(key_in[2]) 
);
  OBUF ain1_obuf (
    .O(ain1),
    .I(ain1_d) 
);
  OBUF ain2_obuf (
    .O(ain2),
    .I(ain2_d) 
);
  OBUF pwm_out_obuf (
    .O(pwm_out),
    .I(pwm_out_d) 
);
  LUT4 n28_s6 (
    .F(n28_15),
    .I0(key_pulse_Z_3[2]),
    .I1(duty_signed[12]),
    .I2(key_pulse_Z_2[1]),
    .I3(key_pulse_Z[0]) 
);
defparam n28_s6.INIT=16'h00F4;
  LUT3 duty_signed_2_s5 (
    .F(duty_signed_2_15),
    .I0(key_pulse_Z[0]),
    .I1(key_pulse_Z_2[1]),
    .I2(key_pulse_Z_3[2]) 
);
defparam duty_signed_2_s5.INIT=8'hFE;
  LUT4 n92_s3 (
    .F(n92_9),
    .I0(duty_signed[2]),
    .I1(key_pulse_Z_3[2]),
    .I2(key_pulse_Z[0]),
    .I3(key_pulse_Z_2[1]) 
);
defparam n92_s3.INIT=16'hFFF2;
  LUT4 n14_s4 (
    .F(n14_10),
    .I0(motor_stop),
    .I1(key_pulse_Z_3[2]),
    .I2(key_pulse_Z[0]),
    .I3(key_pulse_Z_2[1]) 
);
defparam n14_s4.INIT=16'h000E;
  DFFCE duty_signed_8_s1 (
    .Q(duty_signed[8]),
    .D(key_pulse_Z[0]),
    .CLK(clk_d),
    .CE(duty_signed_2_15),
    .CLEAR(n13_6) 
);
defparam duty_signed_8_s1.INIT=1'b0;
  DFFC duty_signed_12_s4 (
    .Q(duty_signed[12]),
    .D(n28_15),
    .CLK(clk_d),
    .CLEAR(n13_6) 
);
defparam duty_signed_12_s4.INIT=1'b0;
  DFFC duty_signed_2_s4 (
    .Q(duty_signed[2]),
    .D(n92_9),
    .CLK(clk_d),
    .CLEAR(n13_6) 
);
defparam duty_signed_2_s4.INIT=1'b0;
  DFFP motor_stop_s3 (
    .Q(motor_stop),
    .D(n14_10),
    .CLK(clk_d),
    .PRESET(n13_6) 
);
defparam motor_stop_s3.INIT=1'b1;
  INV n13_s2 (
    .O(n13_6),
    .I(rst_n_d) 
);
  key key_inst (
    .clk_d(clk_d),
    .n13_6(n13_6),
    .key_in_d(key_in_d[2:0]),
    .key_pulse_Z(key_pulse_Z[0]),
    .key_pulse_Z_0(key_pulse_Z_2[1]),
    .key_pulse_Z_1(key_pulse_Z_3[2])
);
  motor motor_inst (
    .clk_d(clk_d),
    .n13_6(n13_6),
    .motor_stop(motor_stop),
    .duty_signed_2(duty_signed[2]),
    .duty_signed_8(duty_signed[8]),
    .duty_signed_12(duty_signed[12]),
    .pwm_out_d(pwm_out_d),
    .ain1_d(ain1_d),
    .ain2_d(ain2_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* motor_top */
